# LLM Provider
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# Which provider to use: anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o

# Mock app
MOCK_APP_URL=http://localhost:3847
MAX_AGENT_STEPS=25
AGENT_TIMEOUT_MS=120000

# Demo login credentials (used at replay/discovery runtime — NEVER stored in artifacts or logs)
DEMO_USERNAME=shivam
DEMO_PASSWORD=demo123

# Production-style: require secrets from env (no demo defaults). Set to true in prod/CI.
# REQUIRE_ENV_SECRETS=true

# Safety allowlist (domains, routes, action types)
ALLOWED_DOMAINS=localhost,127.0.0.1
ALLOWED_ROUTES=/,/login.html,/main.html,/member-lookup.html,/sub-account.html,/session-expired.html,/api/login,/api/member/*,/api/sub-account
# ALLOWED_ACTIONS=navigate,click,fill,select,press,wait_for,extract,switch_frame
# BLOCKED_ACTIONS=

# Screenshot balance redaction (blur savings/checking amounts before saving PNGs; member name/ID stay visible)
SCREENSHOT_REDACT_PII=true

# LLM rate limit for discovery (calls per minute; disable for unconstrained local dev)
LLM_RATE_LIMIT_RPM=30
# LLM_RATE_LIMIT_DISABLED=true
